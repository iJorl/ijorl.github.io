---
import BaseLayout from '../../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;
const modules = import.meta.glob('../blog/posts/*.{md,mdx}', { eager: true });
const posts = Object.entries(modules).map(([p, mod]: [string, any]) => ({
  url: mod.url,
  frontmatter: mod.frontmatter,
  slug: (p.split('/').pop() as string).replace(/\.(md|mdx)$/, ''),
}));
const sorted = posts.sort((a, b) =>
  new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);

const fmt = (d: string | Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="All Posts - Joël Mathys">
  <section>
    <h1>All Posts</h1>
    <p>
      Every blog post, including drafts and private notes.
      {isDev && <> · <a href="/blog-all/edit">✏️ Write mode</a></>}
    </p>

    {sorted.length === 0 ? (
      <p><em>No posts yet.</em></p>
    ) : (
      <ul class="blog-index">
        {sorted.map(post => {
          const isPrivate = post.frontmatter.public === false;
          return (
            <li class="blog-li">
              {isDev && <a class="edit-btn" href={`/blog-all/edit?slug=${post.slug}`}>✏️ Edit</a>}
              <a href={post.url} class="blog-card">
                <div class="blog-card-image">
                  <img src={post.frontmatter.image} alt={post.frontmatter.imageAlt || post.frontmatter.title} />
                </div>
                <div class="blog-card-content">
                  <h3>
                    {post.frontmatter.title}
                    {isPrivate && <span class="blog-private-tag">private</span>}
                  </h3>
                  <span class="blog-date">{fmt(post.frontmatter.date)}</span>
                  {post.frontmatter.summary && <p>{post.frontmatter.summary}</p>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .blog-li { position: relative; }
  .edit-btn {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #d1d5db;
    border-radius: 6px;
    color: #374151;
    text-decoration: none;
  }
  .edit-btn:hover { background: #2563eb; color: #fff; border-color: #2563eb; }
  .blog-private-tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #fef3c7;
    color: #92400e;
    border-radius: 4px;
    vertical-align: middle;
  }
</style>
